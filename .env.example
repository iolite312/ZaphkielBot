# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Double underscores map to nested configuration sections (Discord__PublicKey -> Discord:PublicKey),
# which is also how the same settings are entered as Application Settings in Azure.
# docker compose hands each app only the variables it needs (see compose.yaml).

# --- Discord: used by ZaphkielBot (https://discord.com/developers/applications) ---
# General Information -> Public Key (64 hex characters). Authenticates every slash command request.
Discord__PublicKey=
# Bot -> Reset Token. Used to register the slash commands and to post messages.
Discord__BotToken=
# Right click the incident channel -> Copy Channel ID (Developer Mode on). Slash commands only work here.
Discord__IncidentChannelId=
# Right click your server -> Copy Server ID. The slash commands are registered to this server (instantly).
# Leave empty to register them globally instead.
Discord__GuildId=

# --- GitHub: used by ZaphkielProcessor ---
# Fine-grained personal access token, scoped to the one repository, permission "Issues: Read and write".
GitHub__Token=
GitHub__Owner=
GitHub__Repository=
# Any random string of 16+ characters (e.g. `openssl rand -hex 32`); enter the same value in the repo webhook settings.
GitHub__WebhookSecret=
